PORT=3000
ADMIN_API_PORT=3002
ADMIN_API_URL=http://localhost:3002
EXPRESS_PORT=3001
SESSION_SECRET=your-random-session-secret-change-at-least-32-chars
BASE_URL=http://localhost:3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# Gmail SMTP (use App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=WallnestBD

# Where new-order alerts are sent (comma-separated; defaults to SMTP_FROM)
OWNER_NOTIFY_EMAIL=your@gmail.com

# Steadfast Courier (https://steadfast.com.bd/user/api)
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=your-steadfast-api-key
STEADFAST_SECRET_KEY=your-steadfast-secret-key
# Set to false to stop auto-booking parcels and use the manual admin button only
STEADFAST_AUTO_CREATE=true

# Meta (Facebook) Pixel — public browser ID
NEXT_PUBLIC_META_PIXEL_ID=1557022736121204
